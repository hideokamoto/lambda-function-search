{
  "name": "lambda-function-search",
  "description": "Search your Lambda functions",
  "version": "0.6.0",
  "author": "Hidetaka Okamoto <info@wp-kyoto.net> (https://wp-kyoto.net)",
  "bin": {
    "lambda-function-search": "./bin/run",
    "lfs": "./bin/run"
  },
  "bugs": "https://github.com/hideokamoto/lambda-function-search/issues",
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.710.0",
    "@aws-sdk/credential-providers": "^3.932.0",
    "@oclif/core": "^4.0.0",
    "chalk": "^4.1.2",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^18.19.0",
    "np": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "/bin",
    "/lib"
  ],
  "homepage": "https://github.com/hideokamoto/lambda-function-search",
  "keywords": [
    "lambda",
    "cli"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "oclif": {
    "bin": "lambda-function-search",
    "commands": {
      "strategy": "single",
      "target": "./lib/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hideokamoto/lambda-function-search.git"
  },
  "scripts": {
    "build": "rm -rf lib && tsc",
    "prepack": "npm run build",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "posttest": "pnpm run lint && tsc -p . --noEmit",
    "release": "np",
    "test": "echo \"No tests yet\"",
    "typecheck": "tsc -p . --noEmit"
  },
  "types": "lib/index.d.ts",
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "overrides": {
      "fast-xml-parser": "^5.12.0"
    }
  }
}
